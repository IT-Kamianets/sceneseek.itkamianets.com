rules_version = '2';

service cloud.firestore {
	match /databases/{database}/documents {
		match /users/{userId}/savedScenes/{sceneId} {
			allow read, write: if request.auth != null && request.auth.uid == userId;
		}

		match /users/{userId}/savedFolders/{folderId} {
			allow read, write: if request.auth != null && request.auth.uid == userId;
		}

		match /users/{userId}/searchHistory/{entryId} {
			allow read, write: if request.auth != null && request.auth.uid == userId;
		}

		match /users/{userId}/viewedScenes/{sceneId} {
			allow read, write: if request.auth != null && request.auth.uid == userId;
		}
	}
}
